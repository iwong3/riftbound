{
    "compilerOptions": {
        "baseUrl": "src",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "jsx": "react-jsx",
        "lib": ["es2022", "dom"],
        "module": "es2022",
        "moduleResolution": "node",
        "strict": true,
        "target": "es2022"
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx"
    ],
    "exclude": [
        "node_modules"
    ]
}

